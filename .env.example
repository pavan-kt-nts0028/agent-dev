# HTTP server
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info          # error | warn | info | debug
LOG_FORMAT=pretty       # pretty | json

# Workspace name -> path mapping, loaded once at boot
WORKSPACES_FILE=config/workspaces.json

# Model provider used when a request omits "model_provider"
AGENT_DEFAULT_PROVIDER=ollama   # ollama | copilot

# Ollama (BYOK, OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=mistral:latest

# Copilot runtime
COPILOT_DEFAULT_MODEL=claude-sonnet-4.5
COPILOT_LOG_LEVEL=error # none | error | warning | info | debug | all
# COPILOT_HOME=/var/lib/agent-dev/copilot
# COPILOT_GITHUB_TOKEN=ghp_...   # omit to use the logged-in `copilot` user

# Session behaviour
AGENT_TURN_TIMEOUT_MS=600000
AGENT_SESSION_IDLE_TIMEOUT_MS=1800000
AGENT_MAX_LIVE_SESSIONS=50
AGENT_PERMISSION_MODE=auto   # auto | readonly

# LLM-generated conversation titles for new sessions
AGENT_TITLE_LLM=true
# AGENT_TITLE_MODEL=qwen2.5:14b   # defaults to the request's model
AGENT_TITLE_TIMEOUT_MS=30000

# Per-turn trace files: one JSONL file per /agent call
AGENT_TURN_LOG=true
AGENT_LOG_DIR=logs
